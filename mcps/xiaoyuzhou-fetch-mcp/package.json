  "description": "MCP server for fetching podcast & episode data from 小宇宙 (Xiaoyuzhou FM)",
  "type": "module",
  "main": "dist/mcp.js",
  "bin": {
    "xiaoyuzhou-fetch-mcp": "dist/mcp.js",
